# Copy this file to ".env" in the project root and fill in real values.
# docker-compose reads this file automatically.

# --- Database ---
DB_NAME=docquery
DB_PASSWORD=root

# --- JWT ---
# Any long random string (32+ characters). Generate one with:
#   openssl rand -base64 32
JWT_SECRET=please-change-this-to-a-long-random-secret-value

# --- LLM Provider ---
# This project works with any OpenAI-compatible provider. Two options below —
# uncomment ONE block. Leave the other commented out.

# OPTION 1: OpenAI (paid, requires billing credit)
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# OPTION 2: Google Gemini (FREE, no credit card required) — recommended if you're not paying
# Get a free key at https://aistudio.google.com/apikey
OPENAI_API_KEY=your-gemini-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-004
OPENAI_CHAT_MODEL=gemini-2.0-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
